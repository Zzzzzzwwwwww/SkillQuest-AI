# ==================== SkillQuest AI 后端环境变量示例 ====================
# 复制本文件为 .env 并修改为实际值：cp .env.example .env

# 应用信息
APP_NAME=SkillQuest AI
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=skillquest
MYSQL_PASSWORD=skillquest
MYSQL_DATABASE=skillquest

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 生产环境务必替换为随机强密钥，可使用：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=skillquest-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 华为云大模型（盘古 / ModelArts）存位 ----------
# 参考：https://support.huaweicloud.com/modelarts/
HUAWEI_LLM_ENDPOINT=https://api.modelarts.yourregion.myhuaweicloud.com
HUAWEI_LLM_API_KEY=
HUAWEI_LLM_MODEL=pangu-5b-chat
HUAWEI_LLM_AUTH_TYPE=apig

# ---------- 向量库 PgVector（预留） ----------
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_USER=skillquest
PGVECTOR_PASSWORD=skillquest
PGVECTOR_DATABASE=skillquest_vector

# ---------- CORS 跨域白名单（逗号分隔） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173