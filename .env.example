# ==================== SkillQuest AI 根环境变量示例 ====================
# 用途：docker-compose 一键编排时使用（backend 容器依赖本文件）
# 复制为 .env 后使用：cp .env.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root-skillquest
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=skillquest
MYSQL_PASSWORD=skillquest
MYSQL_DATABASE=skillquest

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 生成强密钥：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=skillquest-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 应用 ----------
APP_NAME=SkillQuest AI
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- 华为云大模型（盘古 / ModelArts）配置占位 ----------
HUAWEI_LLM_ENDPOINT=https://api.modelarts.yourregion.myhuaweicloud.com
HUAWEI_LLM_API_KEY=
HUAWEI_LLM_MODEL=pangu-5b-chat
HUAWEI_LLM_AUTH_TYPE=apig

# ---------- 向量库 PgVector（预留） ----------
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_USER=skillquest
PGVECTOR_PASSWORD=skillquest
PGVECTOR_DATABASE=skillquest_vector

# ---------- CORS 跨域白名单（逗号分隔） ----------
CORS_ORIGINS=http://localhost:80,http://127.0.0.1:80,http://localhost:5173,http://127.0.0.1:5173